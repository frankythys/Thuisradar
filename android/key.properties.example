# Kopieer naar android/key.properties (staat niet in git) en vul in.
# Uitleg en het keytool-commando: docs/SETUP.md, "Release voor Google Play".
# Gebruik / in het pad, ook op Windows. Bewaar de keystore buiten het project.
storeFile=C:/Users/<jij>/keys/circlebeacon-upload.jks
storePassword=<wachtwoord van de keystore>
keyAlias=upload
keyPassword=<zelfde wachtwoord als storePassword>
